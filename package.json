{
  "name": "supernova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.8.1 <27",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "check": "nx run-many -t lint,typecheck,test",
    "build": "nx run-many -t build:web",
    "dev:progenitor": "nx run progenitor:dev:web",
    "dev:terra": "nx run terra:dev:web",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "graph": "nx graph",
    "format": "biome check --write .",
    "test:tooling": "node --test tooling/native/build.test.mjs tooling/workspace.test.mjs",
    "check:workspace": "biome check . && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present && npm run test:tooling"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "nx": "23.2.0",
    "oxc-transform-react": "0.145.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@codecov/vite-plugin": {
      "vite": "$vite"
    }
  }
}
