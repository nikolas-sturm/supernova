{
  "name": "sol",
  "projectType": "application",
  "implicitDependencies": ["design-system", "native-tooling", "frontend-tooling"],
  "targets": {
    "lint": { "command": "npm run lint --workspace apps/sol" },
    "typecheck": { "command": "npm run typecheck --workspace apps/sol" },
    "test": { "command": "npm run test --workspace apps/sol" },
    "build:web": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npm run build --workspace apps/sol",
        "env": { "SUPERNOVA_WEB_BUILD": "1" }
      },
      "outputs": ["{projectRoot}/build/assets/web"],
      "inputs": [
        "{projectRoot}/src_assets/common/assets/web/**/*",
        "{projectRoot}/vite*.ts",
        "{projectRoot}/tsconfig*.json",
        "{projectRoot}/package.json",
        "{projectRoot}/project.json",
        "sharedGlobals",
        "^production",
        { "env": "NODE_ENV" }
      ]
    },
    "dev": {
      "command": "node tooling/dev.mjs sol",
      "continuous": true,
      "cache": false
    },
    "dev:prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "dev",
      "configurations": { "dev": {} },
      "dependsOn": ["native:build"],
      "options": { "command": "node tooling/dev-assets.mjs" }
    },
    "dev:web": {
      "command": "npm run dev --workspace apps/sol",
      "continuous": true,
      "cache": false
    },
    "native:configure": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "dev",
      "options": { "command": "node tooling/native/build.mjs sol configure debug" },
      "configurations": {
        "debug": {},
        "dev": { "command": "node tooling/native/build.mjs sol configure debug --dev" },
        "release": { "command": "node tooling/native/build.mjs sol configure release" }
      }
    },
    "native:build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["native:configure"],
      "defaultConfiguration": "dev",
      "options": { "command": "node tooling/native/build.mjs sol build debug" },
      "configurations": {
        "debug": {},
        "dev": { "command": "node tooling/native/build.mjs sol build debug --dev" },
        "release": { "command": "node tooling/native/build.mjs sol build release" }
      }
    },
    "native:build-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "dependsOn": ["native:configure"],
      "defaultConfiguration": "dev",
      "options": { "command": "node tooling/native/build.mjs sol build debug --tests" },
      "configurations": {
        "debug": {},
        "dev": { "command": "node tooling/native/build.mjs sol build debug --dev --tests" },
        "release": { "command": "node tooling/native/build.mjs sol build release --tests" }
      }
    },
    "native:test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["native:build-tests"],
      "defaultConfiguration": "dev",
      "options": { "command": "node tooling/native/build.mjs sol test debug" },
      "configurations": {
        "debug": {},
        "dev": { "command": "node tooling/native/build.mjs sol test debug --dev" },
        "release": { "command": "node tooling/native/build.mjs sol test release" }
      }
    },
    "vdd:configure": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "debug",
      "options": { "command": "node tooling/native/build.mjs vdd configure debug" },
      "configurations": {
        "debug": {},
        "release": { "command": "node tooling/native/build.mjs vdd configure release" }
      }
    },
    "vdd:build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["vdd:configure"],
      "defaultConfiguration": "debug",
      "options": { "command": "node tooling/native/build.mjs vdd build debug" },
      "configurations": {
        "debug": {},
        "release": { "command": "node tooling/native/build.mjs vdd build release" }
      }
    },
    "vdd:test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["vdd:build"],
      "defaultConfiguration": "debug",
      "options": { "command": "node tooling/native/build.mjs vdd test debug" },
      "configurations": {
        "debug": {},
        "release": { "command": "node tooling/native/build.mjs vdd test release" }
      }
    }
  }
}
