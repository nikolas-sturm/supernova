{
  "name": "eclipse-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "nx": {
    "includedScripts": []
  },
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "dev": "npm run core:build && neu run -- --window-enable-inspector=true",
    "dev:web": "vite --clearScreen false",
    "build:web": "tsc -b && vite build",
    "core:configure": "node ../../tooling/native/build.mjs terra configure debug",
    "core:build": "npm run core:configure && node ../../tooling/native/build.mjs terra build debug",
    "core:build:release": "node ../../tooling/native/build.mjs terra configure release && node ../../tooling/native/build.mjs terra build release",
    "build": "npm run core:build:release && npm run check && neu build",
    "bundle": "npm run core:build:release && npm run check && neu build --release",
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "neutralino:update": "neu update --latest"
  },
  "dependencies": {
    "@supernova/design-system": "0.1.0",
    "@neutralinojs/lib": "6.9.0",
    "@tanstack/charts": "^0.16.0",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.7.2"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.2",
      "onFail": "warn"
    }
  }
}
